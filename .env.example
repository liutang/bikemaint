# Strava API application credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret used to sign the session cookie
SESSION_SECRET_KEY=

# Path to the local SQLite database file
DATABASE_PATH=./bikemaint.sqlite3

# NOTIFICATION_WEBHOOK_URL is NOT an env var — it's configured in-app
# via /settings/webhook, per account (see contracts/webhook-payload.md).

# Optional tuning (defaults shown)
# STRAVA_SYNC_INTERVAL_MINUTES=30   # first-run default; the rider's saved Settings value overrides it
# NOTIFICATION_CHECK_INTERVAL_MINUTES=60
# LOG_LEVEL=INFO

# Behind a reverse proxy (for example Nginx Proxy Manager at https://bikemaint.example.com):
# PUBLIC_BASE_URL=https://bikemaint.example.com   # pins the Strava redirect address
# FORWARDED_ALLOW_IPS=*                            # trust the proxy's X-Forwarded-* headers (private network only)
