# Strava API application credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Random secret used to sign the session cookie
SESSION_SECRET_KEY=

# Path to the local SQLite database file
DATABASE_PATH=./bikemaint.sqlite3

# NOTIFICATION_WEBHOOK_URL is NOT an env var — it's configured in-app
# via /settings/webhook, per account (see contracts/webhook-payload.md).
